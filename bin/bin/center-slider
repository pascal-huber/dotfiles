MIXER_NAMES = ("mix_l", "mix_r")   # node names inside the filter.graph
CONTROL = "Gain 2"                 # the center/dialogue control
GAIN_MIN, GAIN_MAX, GAIN_DEFAULT = 0.0, 1.3, 0.707
