CONFIG_PATH = Path.home() / ".config" / "dialogue_slider.json"


def load_saved_gain():
    """Last value we wrote, used as a fallback if the live node isn't queryable."""
    try:
        return float(json.loads(CONFIG_PATH.read_text())["gain"])
    except (FileNotFoundError, KeyError, ValueError, json.JSONDecodeError):
        return None


def save_gain(value: float) -> None:
    try:
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
        CONFIG_PATH.write_text(json.dumps({"gain": value}))
    except OSError as e:
        print(f"Could not save gain to {CONFIG_PATH}: {e}", file=sys.stderr)


def get_live_gain(node_id: int):
    """Read the *actual* current value straight from the running filter-chain node."""
    out = get_props_output(node_id)
    if out is None:
        return None
    m = re.search(rf'"{MIXER_NAMES[0]}:{CONTROL}"\s+Float\s+([0-9.eE+-]+)', out)
    return float(m.group(1)) if m else None


def get_props_output(node_id: int):
    try:
        return subprocess.check_output(["pw-cli", "enum-params", str(node_id), "Props"],
                                        text=True)
    except (FileNotFoundError, subprocess.CalledProcessError):
        return None


def get_all_gains(node_id: int):
    """Read every 'Gain N' control for both mixers. Returns {(mixer, n): value}."""
    out = get_props_output(node_id)
    result = {}
    if out is None:
        return result
    for mixer in MIXER_NAMES:
        for n in range(1, 6):
            m = re.search(rf'"{mixer}:Gain {n}"\s+Float\s+([0-9.eE+-]+)', out)
            if m:
                result[(mixer, n)] = float(m.group(1))
    return result


def find_node_id(node_name: str) -> int:
    """Look up the live PipeWire node id for the given node.name via pw-dump."""
    try:
        raw = subprocess.check_output(["pw-dump"], text=True)
    except FileNotFoundError:
        sys.exit("pw-dump not found - is PipeWire installed and on PATH?")
    except subprocess.CalledProcessError as e:
        sys.exit(f"pw-dump failed: {e}")

    data = json.loads(raw)
    for obj in data:
        if obj.get("type") != "PipeWire:Interface:Node":
            continue
        props = obj.get("info", {}).get("props", {})
        if props.get("node.name") == node_name:
            return obj["id"]
    sys.exit(f"Could not find a running node named '{node_name}'. "
              f"Is the filter-chain loaded?")


def set_gain(node_id: int, value: float) -> None:
    params = []
    for m in MIXER_NAMES:
        params.append(f"{m}:{CONTROL}")
        params.append(f"{value:.4f}")
    param_str = " ".join(f'"{p}"' if not p.replace(".", "", 1).replace("-", "", 1).isdigit() else p
                          for p in params)
    cmd_json = '{ params = [ ' + param_str + ' ] }'
    try:
        subprocess.run(["pw-cli", "s", str(node_id), "Props", cmd_json],
                        check=True, capture_output=True, text=True)
    except subprocess.CalledProcessError as e:
        print(f"pw-cli error: {e.stderr}", file=sys.stderr)


def gain_to_db(g: float) -> float:
    import math
    return 20 * math.log10(g / GAIN_DEFAULT) if g > 0 else float("-inf")


def db_to_gain(db: float) -> float:
    return GAIN_DEFAULT * 10 ** (db / 20)


def build_icon_image(size: int = 128):
    """Procedurally draw a cow wearing headphones. No external assets needed."""
    from PIL import Image, ImageDraw

    s = size
    c1 = (255, 247, 235)   # warm cream
    c2 = (222, 214, 255)   # soft lavender
    grad = Image.new("RGB", (s, s))
    px = grad.load()
    for y in range(s):
        for x in range(s):
            t = (x + y) / (2 * (s - 1))
            px[x, y] = (
                int(c1[0] + (c2[0] - c1[0]) * t),
                int(c1[1] + (c2[1] - c1[1]) * t),
                int(c1[2] + (c2[2] - c1[2]) * t),
            )

    mask = Image.new("L", (s, s), 0)
    ImageDraw.Draw(mask).rounded_rectangle([0, 0, s - 1, s - 1], radius=s // 5, fill=255)

    icon = Image.new("RGBA", (s, s), (0, 0, 0, 0))
    icon.paste(grad, (0, 0), mask)
    draw = ImageDraw.Draw(icon)

    cx, cy = s * 0.5, s * 0.56
    hw, hh = s * 0.30, s * 0.26  # head half-width/height

    black = (35, 30, 35, 255)
    outline = (30, 25, 30, 255)

    # ears
    ear_w, ear_h = s * 0.13, s * 0.17
    draw.ellipse([cx - hw - ear_w * 0.5, cy - hh * 0.35, cx - hw + ear_w * 0.6, cy - hh * 0.35 + ear_h],
                 fill=(255, 214, 214, 255), outline=outline, width=3)
    draw.ellipse([cx + hw - ear_w * 0.6, cy - hh * 0.35, cx + hw + ear_w * 0.5, cy - hh * 0.35 + ear_h],
                 fill=(255, 214, 214, 255), outline=outline, width=3)

    # head
    draw.ellipse([cx - hw, cy - hh, cx + hw, cy + hh], fill=(255, 255, 255, 255), outline=outline, width=4)

    # black patches
    draw.polygon([
        (cx - hw * 0.75, cy - hh * 0.7), (cx - hw * 0.05, cy - hh * 0.85), (cx + hw * 0.05, cy - hh * 0.1),
        (cx - hw * 0.55, cy + hh * 0.05),
    ], fill=black)
    draw.polygon([
        (cx + hw * 0.25, cy + hh * 0.15), (cx + hw * 0.85, cy - hh * 0.05), (cx + hw * 0.75, cy + hh * 0.65),
        (cx + hw * 0.15, cy + hh * 0.55),
    ], fill=black)

    # snout
    sw, sh = hw * 1.15, hh * 0.62
    snout_top = cy + hh * 0.55
    draw.rounded_rectangle([cx - sw * 0.5, snout_top, cx + sw * 0.5, snout_top + sh],
                            radius=sh * 0.45, fill=(255, 205, 210, 255), outline=outline, width=3)
    nr = sw * 0.09
    draw.ellipse([cx - sw * 0.22 - nr, snout_top + sh * 0.4, cx - sw * 0.22 + nr, snout_top + sh * 0.4 + nr * 2.2],
                 fill=(120, 70, 80, 255))
    draw.ellipse([cx + sw * 0.22 - nr, snout_top + sh * 0.4, cx + sw * 0.22 + nr, snout_top + sh * 0.4 + nr * 2.2],
                 fill=(120, 70, 80, 255))

    # eyes
    ew, eh = hw * 0.22, hh * 0.30
    for sign in (-1, 1):
        ex = cx + sign * hw * 0.42
        ey = cy - hh * 0.12
        draw.ellipse([ex - ew * 0.5, ey - eh * 0.5, ex + ew * 0.5, ey + eh * 0.5], fill=black)
        draw.ellipse([ex - ew * 0.12, ey - eh * 0.35, ex + ew * 0.12, ey - eh * 0.1], fill=(255, 255, 255, 230))

    # headphones
    band_color = (110, 40, 190, 255)   # deep violet
    cup_color = (0, 214, 255, 255)     # neon cyan
    cup_dark = (0, 150, 190, 255)

    band_r = hw * 1.55
    bbox = [cx - band_r, cy - hh * 1.75, cx + band_r, cy + hh * 0.9]
    draw.arc(bbox, start=190, end=350, fill=band_color, width=int(s * 0.045))

    cup_r = hw * 0.42
    for sign in (-1, 1):
        cup_cx = cx + sign * (hw * 1.02)
        cup_cy = cy - hh * 0.15
        draw.line([cup_cx, cy - hh * 1.05, cup_cx, cup_cy - cup_r * 0.7],
                  fill=band_color, width=int(s * 0.045))
        draw.ellipse([cup_cx - cup_r, cup_cy - cup_r, cup_cx + cup_r, cup_cy + cup_r],
                     fill=cup_color, outline=cup_dark, width=4)
        draw.ellipse([cup_cx - cup_r * 0.45, cup_cy - cup_r * 0.45, cup_cx + cup_r * 0.45, cup_cy + cup_r * 0.45],
                     fill=(20, 20, 30, 255))

    return icon


def _pil_to_photoimage(pil_image):
    """Convert a PIL image to a tk.PhotoImage via in-memory PNG (avoids needing ImageTk)."""
    buf = io.BytesIO()
    pil_image.save(buf, format="PNG")
    return tk.PhotoImage(data=buf.getvalue())


def load_icon_image(icon_path: str = None):
    """Load a user-supplied icon (any Pillow-readable format: PNG, JPG, BMP, ICO...),
    normalized to RGBA. Falls back to the icon embedded in this script (ICON_PNG_B64)
    if no path is given or it can't be loaded. PNG with alpha transparency is
    recommended, square, 128px or larger."""
    from PIL import Image
    if icon_path:
        try:
            return Image.open(icon_path).convert("RGBA")
        except (FileNotFoundError, OSError) as e:
            print(f"Could not load icon '{icon_path}': {e}. Using the embedded logo instead.",
                  file=sys.stderr)
    try:
        return Image.open(io.BytesIO(base64.b64decode(ICON_PNG_B64))).convert("RGBA")
    except Exception as e:
        print(f"Could not decode embedded icon: {e}. Drawing a fallback logo instead.",
              file=sys.stderr)
        return build_icon_image()


class SliderApp:
    def __init__(self, node_name: str, enable_tray: bool = True, icon_path: str = None):
        self.node_name = node_name
        self.node_id = find_node_id(node_name)
        self.tray = None
        self.icon_path = icon_path

        self.root = tk.Tk(className=WM_CLASS)
        self.root.title("Dialogue / Center Level")
        self.root.geometry("620x340")

        # sway/i3 auto-float windows whose _NET_WM_WINDOW_TYPE is "dialog" by
        # default, so this alone is usually enough - no sway.config edit needed.
        try:
            self.root.wm_attributes("-type", "dialog")
        except tk.TclError:
            pass  # not on X11/XWayland; harmless to skip

        try:
            self._icon_image = load_icon_image(icon_path)
            self._icon_photo = _pil_to_photoimage(self._icon_image)
            self.root.iconphoto(True, self._icon_photo)
        except ImportError:
            pass  # Pillow not installed; window just uses the default icon

        if enable_tray:
            self._setup_tray()

        self.root.protocol("WM_DELETE_WINDOW", self.on_close)

        ttk.Label(self.root, text="Dialogue boost (Front Center gain)",
                  font=("sans-serif", 11)).pack(pady=(14, 2))

        self.value_label = ttk.Label(self.root, text="", font=("sans-serif", 10))
        self.value_label.pack()

        initial = get_live_gain(self.node_id)
        source = "live"
        if initial is None:
            initial = load_saved_gain()
            source = "saved"
        if initial is None:
            initial = GAIN_DEFAULT
            source = "default"
        print(f"Starting at gain {initial:.3f} (from {source})")

        self.var = tk.DoubleVar(value=initial)
        self.slider = ttk.Scale(self.root, from_=GAIN_MIN, to=GAIN_MAX,
                                 orient="horizontal", variable=self.var,
                                 length=580, command=self.on_change)
        self.slider.pack(pady=10)

        btn_frame = ttk.Frame(self.root)
        btn_frame.pack(pady=(4, 10))
        for label, db in PRESETS_DB:
            db_str = "0dB" if db == 0 else f"{db:+d}dB"
            ttk.Button(btn_frame, text=f"{label}\n{db_str}",
                       command=lambda d=db: self.set_preset(db_to_gain(d))).pack(
                side="left", padx=4)

        ttk.Separator(self.root, orient="horizontal").pack(fill="x", pady=(4, 8), padx=10)

        ttk.Label(self.root, text="Other channel gains (read-only)",
                  font=("sans-serif", 9, "italic")).pack()

        other_frame = ttk.Frame(self.root)
        other_frame.pack(pady=(4, 10))
        self.other_labels = {}
        for row, (n, desc) in enumerate(OTHER_GAINS):
            ttk.Label(other_frame, text=f"Gain {n} ({desc}):",
                      font=("sans-serif", 9)).grid(row=row, column=0, sticky="w", padx=4)
            lbl = ttk.Label(other_frame, text="--", font=("sans-serif", 9))
            lbl.grid(row=row, column=1, sticky="w", padx=4)
            self.other_labels[n] = lbl

        self.on_change()
        self.refresh_other_gains()

    def _setup_tray(self):
        try:
            import pystray
        except ImportError:
            print("pystray not installed - tray icon disabled. "
                  "Install with: pip install pystray pillow --break-system-packages",
                  file=sys.stderr)
            return

        image = getattr(self, "_icon_image", None) or load_icon_image(self.icon_path)

        def make_preset_handler(db):
            def handler(icon, item):
                self.root.after(0, lambda: self.set_preset(db_to_gain(db)))
            return handler

        items = [pystray.MenuItem("Show / Hide window", self._tray_toggle, default=True)]
        for label, db in PRESETS_DB:
            db_str = "0dB" if db == 0 else f"{db:+d}dB"
            items.append(pystray.MenuItem(f"{label} ({db_str})", make_preset_handler(db)))
        items.append(pystray.Menu.SEPARATOR)
        items.append(pystray.MenuItem("Quit", self._tray_quit))

        self.tray = pystray.Icon("dialogue_slider", image, "Dialogue Boost",
                                  menu=pystray.Menu(*items))

        # Some pystray backends (e.g. GTK on Python 3.14) call signal.signal()
        # from inside their run loop to reset SIGINT, which only works on the
        # main thread. Since the tray loop necessarily runs off-thread here
        # (Tkinter owns the main thread), patch signal.signal to no-op when
        # called from anywhere but the main thread, so that call is silently
        # skipped instead of raising. This applies whether the loop is started
        # via run_detached() or a plain thread - both hit the same code path.
        self._patch_signal_for_background_threads()
        try:
            self.tray.run_detached()
        except (AttributeError, NotImplementedError):
            threading.Thread(target=self.tray.run, daemon=True).start()

    @staticmethod
    def _patch_signal_for_background_threads():
        import signal
        if getattr(signal.signal, "_dialogue_slider_patched", False):
            return  # already patched
        orig_signal = signal.signal

        def guarded_signal(sig, handler):
            if threading.current_thread() is threading.main_thread():
                return orig_signal(sig, handler)
            return None  # silently skip signal setup from background threads

        guarded_signal._dialogue_slider_patched = True
        signal.signal = guarded_signal

    def _tray_toggle(self, icon=None, item=None):
        self.root.after(0, self.toggle_visibility)

    def _tray_quit(self, icon=None, item=None):
        if self.tray:
            self.tray.stop()
        self.root.after(0, self.root.destroy)

    def toggle_visibility(self):
        if self.root.state() == "withdrawn":
            self.root.deiconify()
            self.root.lift()
        else:
            self.root.withdraw()

    def on_close(self):
        # If we have a tray icon, closing the window just hides it; otherwise quit for real.
        if self.tray:
            self.root.withdraw()
        else:
            self.root.destroy()

    def refresh_other_gains(self):
        gains = get_all_gains(self.node_id)
        for n, _desc in OTHER_GAINS:
            l = gains.get(("mix_l", n))
            r = gains.get(("mix_r", n))
            if l is None and r is None:
                text = "unavailable"
            elif l == r:
                text = f"{l:.3f}"
            else:
                text = f"L={l:.3f}  R={r:.3f}"
            self.other_labels[n].config(text=text)
        self.root.after(2000, self.refresh_other_gains)

    def on_change(self, _evt=None):
        g = self.var.get()
        set_gain(self.node_id, g)
        save_gain(g)
        db = gain_to_db(g)
        db_str = "-inf" if g == 0 else f"{db:+.1f} dB"
        self.value_label.config(text=f"Gain = {g:.3f}   ({db_str})")

    def set_preset(self, value):
        self.var.set(value)
        self.on_change()

    def run(self):
        self.root.mainloop()


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--node-name", default="center_adjustable_downmix_7_1",
                         help="capture.props.node.name of your filter-chain "
                              "(default: center_adjustable_downmix_7_1)")
    parser.add_argument("--no-tray", action="store_true",
                         help="disable the system tray icon")
    parser.add_argument("--icon", default=None, metavar="PATH",
                         help="path to a custom icon image (PNG recommended, square, "
                              "128px+, with alpha transparency). Falls back to the "
                              "built-in cow-with-headphones logo if omitted or unreadable.")
    args = parser.parse_args()

    app = SliderApp(args.node_name, enable_tray=not args.no_tray, icon_path=args.icon)
    app.run()

