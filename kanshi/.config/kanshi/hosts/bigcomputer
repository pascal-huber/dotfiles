profile all {
  output DP-1 enable
  output DP-2 enable
  output HDMI-A-1 enable
  exec ~/bin/do all
}
profile work {
  output DP-1 enable
  output DP-2 enable
  exec ~/bin/do work
}
profile workmain {
  output DP-1 enable
  exec ~/bin/do workmain
}
profile workside {
  output DP-2 enable
  exec ~/bin/do workside
}
profile tv {
  output HDMI-A-1 enable
  exec ~/bin/do tv
}

