profile all {
    output DP-2 enable mode 3440x1440@144Hz position 0,0
    output DP-3 enable mode 1920x1080 position 3440,0
    output HDMI-A-1 enable mode 1920x1080@120Hz position 5360,0 scale 1
    exec swaymsg output HDMI-A-1 render_bit_depth 10 hdr on
}
profile tv {
    output HDMI-A-1 enable mode 1920x1080@120Hz position 0,0 scale 1
    output DP-2 disable
    output DP-3 disable
    exec swaymsg output HDMI-A-1 render_bit_depth 10 hdr on
}
profile tv4k {
    output HDMI-A-1 enable mode 3840x2160@60Hz position 0,0 scale 2
    output DP-2 disable
    output DP-3 disable
    exec swaymsg output HDMI-A-1 render_bit_depth 10 hdr on
}
profile work {
    output DP-2 enable mode 3440x1440@144Hz position 0,0
    output DP-3 enable mode 1920x1080 position 3440,0
    output HDMI-A-1 disable
}
profile work270 {
    output DP-2 enable mode 3440x1440@144Hz position 0,0
    output DP-3 enable mode 1920x1080 position 3440,0 transform 270
    output HDMI-A-1 disable
}
