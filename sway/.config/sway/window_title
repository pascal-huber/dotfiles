# get properties of window
#  swaymsg -t get_tree | jq

# Default Title
for_window [class=".*"] title_format \
" <span size='medium' foreground='#aaaaff' font='DejaVu Sans Mono Bold 12'>#</span>  %title"

# Terminals
for_window [app_id="Alacritty"] title_format \
" <span size='medium' foreground='#f25c01' font='DejaVu Sans Mono Bold 12'>T</span>  %title"
for_window [class="URxvt"] title_format \
" <span size='medium' foreground='#f25c01' font='DejaVu Sans Mono Bold 12'>T</span>  %title"
for_window [class="xst-256color"] title_format \
" <span size='medium' foreground='#f25c01' font='DejaVu Sans Mono Bold 12'>T</span>  %title"
