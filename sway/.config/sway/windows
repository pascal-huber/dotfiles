
# non-gaps
for_window [class=".*"] border normal

# Floating windows
for_window [app_id="org.keepassxc.KeePassXC"] floating enable, resize set 1280 90 ppt
for_window [app_id="pavucontrol"] floating enable, resize set 1000 90 ppt
for_window [class="Xsane"] floating enable
for_window [class="zoom"] floating enable, border none

